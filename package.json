{
  "name": "coingecko-api",
  "type": "module",
  "main": "bin/index.js",
  "description": "Serves data on the Olympus protocol to the CoinGecko API",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@pulumi/gcp": "^9.37.1",
    "@pulumi/pulumi": "^3.274.1",
    "@types/node": "22.9.3",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@olympusdao/treasury-subgraph-client": "^3.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check --write src",
    "lint:check": "biome check src",
    "start": "pnpm run build && node bin/app/cli.js"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.28.7 <12",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  },
  "packageManager": "pnpm@11.28.9"
}
