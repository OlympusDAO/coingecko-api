{
  "name": "coingecko-api",
  "type": "module",
  "main": "src/index.ts",
  "description": "Serves data on the Olympus protocol to the CoinGecko API",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@pulumi/gcp": "^9.18.0",
    "@pulumi/pulumi": "^3.229.0",
    "@types/node": "22.9.3",
    "ts-node": "^10.9.2",
    "tsx": "4.22.4",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@google-cloud/firestore": "^6.5.0",
    "@olympusdao/treasury-subgraph-client": "^3.0.0"
